{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ruxi C1 frozen content graph",
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 0,
              "maxItems": 10
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1,
              "maxItems": 10
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "public_clue": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            }
          },
          "required": [
            "public_clue"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "knows_clue": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            }
          },
          "required": [
            "knows_clue"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "owns_item": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            }
          },
          "required": [
            "owns_item"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "var": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            },
            "eq": {
              "type": [
                "boolean",
                "integer"
              ]
            }
          },
          "required": [
            "var",
            "eq"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "story_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "seat_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 4
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true
    },
    "phases": {
      "const": [
        "briefing",
        "exploration",
        "decision"
      ]
    },
    "variables": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "bool"
              },
              "initial": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "initial"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "int"
              },
              "initial": {
                "type": "integer"
              },
              "min": {
                "type": "integer"
              },
              "max": {
                "type": "integer"
              }
            },
            "required": [
              "type",
              "initial",
              "min",
              "max"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "role": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "phase": {
            "const": "exploration"
          },
          "requires": {
            "$ref": "#/$defs/condition"
          },
          "effects": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "grant_clue": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                    },
                    "visibility": {
                      "enum": [
                        "actor",
                        "public"
                      ]
                    }
                  },
                  "required": [
                    "grant_clue",
                    "visibility"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "grant_item": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                    },
                    "visibility": {
                      "enum": [
                        "actor",
                        "public"
                      ]
                    }
                  },
                  "required": [
                    "grant_item",
                    "visibility"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "set_variable": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                    },
                    "value": {
                      "type": [
                        "boolean",
                        "integer"
                      ]
                    }
                  },
                  "required": [
                    "set_variable",
                    "value"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1,
            "maxItems": 10
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "id",
          "role",
          "phase",
          "requires",
          "effects"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 50
    },
    "decision": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 900000
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        },
        "eligibility": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/condition"
          }
        },
        "default_option": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "tie_priority": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        },
        "endings": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          }
        }
      },
      "required": [
        "duration_ms",
        "options",
        "eligibility",
        "default_option",
        "tie_priority",
        "endings"
      ],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "exploration_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 900000
        },
        "interlude_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 900000
        },
        "ending_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 900000
        }
      },
      "required": [
        "exploration_ms",
        "interlude_ms",
        "ending_ms"
      ],
      "additionalProperties": false
    },
    "media": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "minItems": 5,
      "maxItems": 16,
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "media_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "asset_id": {
            "type": "string",
            "format": "uuid"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 900000
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "media_id",
          "asset_id",
          "sha256",
          "duration_ms",
          "summary",
          "source"
        ],
        "additionalProperties": false
      },
      "minItems": 5,
      "maxItems": 16
    },
    "asset_status": {
      "enum": [
        "programmatic_demo_ready",
        "ready",
        "draft",
        "missing_original_video"
      ]
    },
    "demo_only": {
      "type": "boolean"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "min_protocol_version": {
      "const": 1
    },
    "role_definitions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "public_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "clues": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 50,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "shareable": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "text",
          "shareable"
        ],
        "additionalProperties": false
      }
    },
    "option_labels": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "hints": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "exploration": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "minItems": 2,
            "maxItems": 2
          },
          "decision": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "story_id",
    "title",
    "seat_count",
    "roles",
    "phases",
    "variables",
    "actions",
    "decision",
    "timing",
    "media",
    "assets",
    "asset_status",
    "demo_only"
  ],
  "additionalProperties": false
}
