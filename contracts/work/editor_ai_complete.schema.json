{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lease_token": {
      "type": "string",
      "maxLength": 500,
      "minLength": 1
    },
    "result_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result": {
      "type": "object",
      "properties": {
        "proposal_ref": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "proposal_ref",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "attempt",
    "lease_token",
    "result_hash",
    "result"
  ],
  "additionalProperties": false
}
