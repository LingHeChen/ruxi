{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lease_token": {
      "type": "string",
      "maxLength": 500,
      "minLength": 1
    },
    "result_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result": {
      "type": "object",
      "properties": {
        "outputs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "asset_id": {
                "type": "string",
                "format": "uuid"
              },
              "object_key": {
                "type": "string",
                "maxLength": 500,
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "mime_type": {
                "enum": [
                  "video/mp4",
                  "image/jpeg",
                  "text/vtt"
                ]
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 524288000
              }
            },
            "required": [
              "asset_id",
              "object_key",
              "sha256",
              "mime_type",
              "size_bytes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "outputs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "attempt",
    "lease_token",
    "result_hash",
    "result"
  ],
  "additionalProperties": false
}
