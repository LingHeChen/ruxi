{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "lease_token": {
      "type": "string",
      "minLength": 1
    },
    "result_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "type": "object",
      "properties": {
        "narrative": {
          "type": "string",
          "maxLength": 2000
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:-]{1,64}$"
          },
          "maxItems": 100
        }
      },
      "required": [
        "narrative",
        "evidence_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "attempt",
    "lease_token",
    "result_hash",
    "result"
  ],
  "additionalProperties": false
}
