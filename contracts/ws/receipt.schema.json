{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "committed",
        "rejected"
      ]
    },
    "receipt_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "trace_id": {
      "type": "string",
      "format": "uuid"
    },
    "result": {
      "type": "object"
    },
    "error": {
      "type": "object"
    }
  },
  "required": [
    "command_id",
    "status",
    "receipt_seq",
    "trace_id"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "committed"
        }
      },
      "required": [
        "result"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "properties": {
        "status": {
          "const": "rejected"
        }
      },
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "result"
        ]
      }
    }
  ]
}
