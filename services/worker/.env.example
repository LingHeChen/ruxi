# Copy to .env in this directory, or export settings; never put keys in Flutter.
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
DEEPSEEK_API_KEY=
CORE_URL=http://localhost:4000
WORKER_ID=local-hint-worker
WORKER_TOKEN=local-worker-change-me

# Production: separate AI and media services, with credentials restricted per kind.
SUPPORTED_KINDS=player_hint,editor_ai,media_transcode
