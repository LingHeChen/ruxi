{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "title": {
      "type": "string"
    },
    "rules": {
      "type": "object",
      "properties": {
        "ap_per_round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "step_timeout_s": {
          "type": "integer",
          "minimum": 15,
          "maximum": 300
        },
        "proposal_ttl_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "round_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "ap_per_round",
        "step_timeout_s",
        "proposal_ttl_s",
        "round_limit"
      ],
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "knowledge": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "label",
          "location",
          "knowledge"
        ],
        "additionalProperties": false
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "discovered": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "discovered"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "cost": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "condition": {
            "$ref": "#/$defs/condition"
          },
          "discovered": {
            "type": "boolean",
            "default": true
          },
          "display_condition": {
            "$ref": "#/$defs/condition"
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "cost",
          "condition"
        ],
        "additionalProperties": false
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "label",
          "location",
          "tags"
        ],
        "additionalProperties": false
      }
    },
    "clues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "text": {
            "type": "string"
          },
          "shareable": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "text",
          "shareable"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "cost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "condition": {
            "$ref": "#/$defs/condition"
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/effect"
            }
          },
          "failure": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/effect"
            }
          },
          "threshold": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100
          },
          "max_uses": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "display_condition": {
            "$ref": "#/$defs/condition"
          },
          "required_participants": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "risk_text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "location",
          "target",
          "cost",
          "condition",
          "effects",
          "failure",
          "threshold",
          "max_uses"
        ],
        "additionalProperties": false
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "cost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "condition": {
            "$ref": "#/$defs/condition"
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/effect"
            }
          },
          "failure": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/effect"
            }
          },
          "threshold": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100
          },
          "max_uses": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "intent": {
            "type": "string"
          },
          "required_tag": {
            "type": "string"
          },
          "display_condition": {
            "$ref": "#/$defs/condition"
          },
          "required_participants": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "risk_text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "location",
          "target",
          "cost",
          "condition",
          "effects",
          "failure",
          "threshold",
          "max_uses",
          "intent",
          "required_tag"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "trigger": {
            "enum": [
              "room_start",
              "action_end",
              "step_end",
              "round_end"
            ]
          },
          "priority": {
            "type": "integer"
          },
          "condition": {
            "$ref": "#/$defs/condition"
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/effect"
            }
          },
          "once": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "trigger",
          "priority",
          "condition",
          "effects",
          "once"
        ],
        "additionalProperties": false
      }
    },
    "initial": {
      "type": "object",
      "properties": {
        "world": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean",
              "null"
            ]
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      },
      "required": [
        "world",
        "inventory"
      ],
      "additionalProperties": false
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "image",
              "video",
              "audio",
              "text"
            ]
          },
          "uri": {
            "type": "string"
          },
          "audience": {
            "oneOf": [
              {
                "enum": [
                  "public"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "uri",
          "audience",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "votes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "duration_s": {
            "type": "integer",
            "minimum": 15,
            "maximum": 300
          },
          "default_option": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "label": {
                  "type": "string"
                },
                "condition": {
                  "$ref": "#/$defs/condition"
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/effect"
                  }
                }
              },
              "required": [
                "id",
                "label",
                "condition",
                "effects"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "duration_s",
          "default_option",
          "options"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "rules",
    "roles",
    "locations",
    "links",
    "objects",
    "clues",
    "actions",
    "templates",
    "events",
    "initial",
    "media"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruxi.example/schema/story-v3",
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "all",
                "any"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "not"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "eq",
                "ne",
                "gte",
                "lte"
              ]
            },
            "ref": {
              "type": "string"
            },
            "value": {
              "type": [
                "string",
                "integer",
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "op",
            "ref",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "has_knowledge",
                "owns"
              ]
            },
            "ref": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "op",
            "ref"
          ],
          "additionalProperties": false
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "set"
            },
            "ref": {
              "type": "string"
            },
            "value": {
              "type": [
                "string",
                "integer",
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "op",
            "ref",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "move",
                "end"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "reveal"
            },
            "ref": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "audience": {
              "enum": [
                "self",
                "all"
              ]
            }
          },
          "required": [
            "op",
            "ref",
            "audience"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "grant"
            },
            "ref": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "op",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "cue"
            },
            "ref": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "audience": {
              "enum": [
                "self",
                "all"
              ]
            },
            "blocking": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "ref",
            "audience",
            "blocking"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "start_vote"
            },
            "ref": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "op",
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "discover"
            },
            "ref": {
              "type": "string"
            },
            "audience": {
              "enum": [
                "self",
                "all"
              ]
            }
          },
          "required": [
            "op",
            "ref",
            "audience"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}