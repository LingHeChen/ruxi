        "args": []
      },
      "effects": [
        {
          "op": "reveal",
          "ref": "stain",
          "audience": "self"
        }
      ],
      "failure": [],
      "threshold": null,
      "max_uses": 1
    },
    {
      "id": "meal",
      "label": "用餐",
      "location": "dining",
