        {
          "op": "reveal",
          "ref": "access",
          "audience": "self"
        }
      ],
      "failure": [],
      "threshold": null,
      "max_uses": 1
    },
    {
      "id": "take_tool",
      "label": "取下灭火器",
      "location": "hall",
      "target": "fire_extinguisher",
      "cost": 1,
      "condition": {
        "op": "all",
        "args": []
      },
      "effects": [
        {
          "op": "grant",
          "ref": "fire_extinguisher"
        }
      ],
      "failure": [],
      "threshold": null,
      "max_uses": 1
    },
