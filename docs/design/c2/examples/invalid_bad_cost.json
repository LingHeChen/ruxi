      "condition": {
        "op": "all",
        "args": [
          {
            "op": "has_knowledge",
            "ref": "access"
          },
          {
            "op": "eq",
            "ref": "world.door_open",
            "value": false
          }
        ]
      },
      "effects": [
        {
          "op": "set",
          "ref": "world.door_open",
          "value": true
        }
      ],
      "failure": [],
      "threshold": null,
      "max_uses": 1
    },
    {
      "id": "switch_off",
      "label": "关闭故障电源",
      "location": "kitchen",
      "target": "power_box",
      "cost": 1,
      "condition": {
        "op": "eq",
        "ref": "world.power_off",
        "value": false
      },
      "effects": [
        {
          "op": "set",
          "ref": "world.power_off",
          "value": true
        }
      ],
      "failure": [],
      "threshold": null,
      "max_uses": 1
    }
  ],
  "templates": [
    {
      "id": "force_door",
      "label": "用灭火器破门",
      "location": "hall",
      "target": "door",
      "cost": 2,
      "condition": {
        "op": "all",
        "args": [
          {
            "op": "owns",
            "ref": "fire_extinguisher"
          },
          {
            "op": "eq",
            "ref": "world.door_open",
            "value": false
          }
        ]
      },
      "effects": [
        {
          "op": "set",
          "ref": "world.door_open",
          "value": true
        },
        {
          "op": "set",
          "ref": "world.noise",
          "value": true
        }
      ],
      "failure": [],
      "threshold": null,
      "max_uses": 1,
      "intent": "使用工具破坏目标",
      "required_tag": "breakable"
    }
  ],
  "events": [
    {
      "id": "safe_ending",
      "trigger": "step_end",
      "priority": 10,
      "condition": {
        "op": "eq",
        "ref": "world.power_off",
        "value": true
      },
      "effects": [
        {
          "op": "end",
          "value": "safe"
        }
      ],
      "once": true
    },
    {
      "id": "timeout",
      "trigger": "round_end",
      "priority": 100,
      "condition": {
        "op": "gte",
        "ref": "clock.round",
        "value": 4
      },
      "effects": [
        {
          "op": "end",
          "value": "evacuated"
        }
      ],
      "once": true
    }
  ],
  "initial": {
    "world": {
      "door_open": false,
      "power_off": false,
      "noise": false
    },
    "inventory": {
      "guest": [],
      "doctor": [],
      "reporter": []
    }
  },
