  "objects": [
    {
      "id": "letter",
      "label": "母亲的旧信",
      "location": "office",
      "description": "写给你的信，夹着一把档案室钥匙。那句“我会回来”，已经迟到了二十年。",
      "tags": [
        "inspectable"
      ]
    },
    {
      "id": "photo",
      "label": "泛黄的合照",
      "location": "office",
