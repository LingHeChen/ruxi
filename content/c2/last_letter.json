      "id": "keeper",
      "label": "值夜人",
      "location": "office",
      "knowledge": [],
      "goals": [
        "找出母亲在雨夜离开的原因，以及是谁把旧信送到门前。"
      ]
    }
  ],
  "locations": [
    {
      "id": "office",
      "label": "值班室",
      "description": "雨水沿窗玻璃蜿蜒而下。桌上的旧信封没有邮票，收件人却写着你的名字。",
      "discovered": true
    },
    {
      "id": "archive",
      "label": "档案室",
      "description": "雨水正从屋顶裂缝滴下。桌上的投递簿与录音带，不能同时抢救。",
      "discovered": false
    }
  ],
