    "narrative_cues": [
      {
        "blocking": true,
        "id": "9ecbbfe0-051c-48a9-aedd-0f9b64b2fe2f",
        "image_uri": "assets/stories/tide_hotel/lobby-v2.png",
        "kind": "image",
        "media_id": "opening",
        "text": "你叫徐闻，给一家地方电台做声音纪录。今晚，你带着录音笔来到潮汐旅馆，赴作家江临的约。他在邀请信里只写了一句：“如果钟声响到第九下，请别相信第一个解释。”\n渡船在你到岛后停航。你进门时，海景餐厅传来九声缓慢的钟响。接待台的林素说，江临不见了。她伸手去关录音笔，你却发现她的手在抖。\n这不是限时逃生。你可以随时回看线索，逐个询问在场的人，按自己的节奏查证。天气推进采用调查回合，不等于现实分钟；阅读对话时不会扣行动点。开场先问林素，再检查钟，能得到第一组相互矛盾的时间。\n你这次要找的也许不只是一个失踪的人。十五年前，有一个已经回到岸上的名字，被重新写回了海里。"
      }
    ],
    "npcs": [
      {
        "description": "48岁，旅馆经营者。克制、礼貌，习惯替别人把话说完。你可以询问她的证词，也可以在掌握新证据后回访。",
        "id": "lin",
        "image_uri": "assets/stories/tide_hotel/npc-lin.png",
        "label": "林素"
      }
